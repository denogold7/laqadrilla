{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--output-dir", "output/ejecuciones/evidencia"],
      "enabled": true
    },
    "playwright-headless": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--output-dir", "output/ejecuciones/evidencia"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "newman *": "allow",
      "npx newman *": "allow",
      "python scripts/*": "allow",
      "python3 scripts/*": "allow",
      "*": "ask"
    }
  }
}
